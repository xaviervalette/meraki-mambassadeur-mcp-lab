# Token d'accès du bot Webex (https://developer.webex.com/my-apps)
WEBEX_BOT_TOKEN=<TOKEN_BOT_WEBEX>
# Identifiant de l'espace cible (le bot doit en être membre)
WEBEX_ROOM_ID=<ID_ESPACE_WEBEX>

# Token que les clients MCP doivent présenter (Authorization: Bearer ...)
# Générez-en un avec : openssl rand -hex 32
MCP_AUTH_TOKEN=<TOKEN_MCP>
# Adresse et port d'écoute du serveur HTTP (endpoint : /mcp)
MCP_HOST=127.0.0.1
MCP_PORT=8000
